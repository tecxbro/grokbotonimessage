{
  "name": "grok-bot-cli",
  "version": "0.2.2",
  "description": "CLI for Grok Bot agents and groups: create, update, message, inspect threads, and automate cleanup",
  "type": "module",
  "bin": {
    "gbot": "src/cli.js",
    "grok-bot": "src/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "changeset": "changeset",
    "gbot": "node src/cli.js",
    "release": "changeset publish",
    "test": "node --test test/*.test.js",
    "photon:build": "npm run build --workspace=@grokbot/photon-features",
    "photon:test": "npm run test --workspace=@grokbot/photon-features",
    "photon:check": "npm run check --workspace=@grokbot/photon-features",
    "photon:test:integration": "npm run photon:build && node scripts/run-integration-tests.mjs",
    "photon:f0": "node scripts/verify-lane.mjs wt-00",
    "photon:verify-all": "node scripts/verify-all.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tecxbro/grokbotonimessage.git"
  },
  "homepage": "https://github.com/tecxbro/grokbotonimessage#readme",
  "bugs": {
    "url": "https://github.com/tecxbro/grokbotonimessage/issues"
  },
  "author": "tecxbro (https://github.com/tecxbro)",
  "license": "MIT",
  "keywords": [
    "grok",
    "grok-bot",
    "grokbot",
    "gbot",
    "cursor",
    "ai-agents",
    "automation",
    "terminal",
    "cli"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.1"
  },
  "dependencies": {
    "spectrum-ts": "12.8.0"
  },
  "workspaces": [
    "packages/photon-features"
  ],
  "packageManager": "npm@10.9.2"
}
