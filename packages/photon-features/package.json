{
  "name": "@grokbot/photon-features",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "bin": {
    "grok-photon": "dist/src/cli/main.js",
    "grok-photon-host": "dist/src/host/process.js",
    "grok-photon-task": "dist/src/host/task-launcher.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./contracts": "./dist/src/contracts/index.js",
    "./state": "./dist/src/state/index.js",
    "./host": "./dist/src/host/index.js",
    "./registry": "./dist/src/registry/index.js",
    "./foundation": "./dist/src/host/main.js",
    "./feature": "./dist/src/contracts/feature.js",
    "./services": "./dist/src/contracts/services.js",
    "./integration": "./dist/src/integration/index.js"
  },
  "files": [
    "dist/src",
    "bin",
    "schemas",
    "src/state/migrations",
    "SKILL.md",
    "DEPLOYMENT.md",
    "INSTALL.md",
    "README.md",
    "scripts",
    "examples",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/lanes/wt-00/*.test.js",
    "test:lane": "npm run build && node --test",
    "generate": "npm run build && node ../../scripts/generate-contracts.mjs",
    "check": "npm run build && node ../../scripts/generate-contracts.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:foundation": "npm run build && node --test dist/tests/foundation/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@photon-ai/advanced-imessage": "2.1.0",
    "nice-grpc": "2.1.17",
    "nice-grpc-common": "2.0.4",
    "spectrum-ts": "12.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
