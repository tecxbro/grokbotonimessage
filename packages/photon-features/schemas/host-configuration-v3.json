{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 3
    },
    "activation": {
      "type": "string",
      "enum": [
        "disabled",
        "enabled"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "spectrum-cloud-imessage"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "projectSecretFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "lineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{6,14}$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "dedicated": {
          "type": "boolean"
        },
        "availableOperations": {
          "minItems": 1,
          "maxItems": 44,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typing.begin",
              "typing.end",
              "text.send",
              "text.stream",
              "markdown.send",
              "link.send",
              "content.group",
              "content.compose",
              "message.get",
              "message.reply",
              "message.react",
              "reaction.remove",
              "message.edit",
              "message.unsend",
              "message.markRead",
              "attachment.send",
              "attachment.fetch",
              "voice.send",
              "contact.send",
              "poll.create",
              "poll.get",
              "poll.vote",
              "poll.unvote",
              "poll.addOption",
              "app.send",
              "app.sendCustomized",
              "app.update",
              "space.get",
              "space.create",
              "space.getName",
              "space.rename",
              "space.getMembers",
              "space.addMembers",
              "space.removeMembers",
              "space.leave",
              "space.getAvatar",
              "space.setAvatar",
              "space.clearAvatar",
              "space.setBackground",
              "space.clearBackground",
              "account.shareContact",
              "effect.send",
              "metadata.get",
              "custom.send"
            ]
          }
        },
        "initialAddress": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "projectSecretFormat": {
          "default": "raw",
          "type": "string",
          "enum": [
            "raw",
            "photon-project-secret-v1"
          ]
        }
      },
      "required": [
        "kind",
        "projectId",
        "projectSecretFile",
        "accountId",
        "lineId",
        "dedicated",
        "availableOperations",
        "projectSecretFormat"
      ],
      "additionalProperties": false
    },
    "local": {
      "type": "object",
      "properties": {
        "socketPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "credentialFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "credentialId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        }
      },
      "required": [
        "socketPath",
        "credentialFile",
        "principalId",
        "credentialId"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "permissions": {
          "minItems": 1,
          "maxItems": 44,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typing.begin",
              "typing.end",
              "text.send",
              "text.stream",
              "markdown.send",
              "link.send",
              "content.group",
              "content.compose",
              "message.get",
              "message.reply",
              "message.react",
              "reaction.remove",
              "message.edit",
              "message.unsend",
              "message.markRead",
              "attachment.send",
              "attachment.fetch",
              "voice.send",
              "contact.send",
              "poll.create",
              "poll.get",
              "poll.vote",
              "poll.unvote",
              "poll.addOption",
              "app.send",
              "app.sendCustomized",
              "app.update",
              "space.get",
              "space.create",
              "space.getName",
              "space.rename",
              "space.getMembers",
              "space.addMembers",
              "space.removeMembers",
              "space.leave",
              "space.getAvatar",
              "space.setAvatar",
              "space.clearAvatar",
              "space.setBackground",
              "space.clearBackground",
              "account.shareContact",
              "effect.send",
              "metadata.get",
              "custom.send"
            ]
          }
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "grokAgentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        }
      },
      "required": [
        "contextId",
        "taskId",
        "generation",
        "permissions",
        "issuedAt",
        "expiresAt",
        "grokAgentId"
      ],
      "additionalProperties": false
    },
    "grok": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "timeoutMs": {
          "default": 15000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        }
      },
      "required": [
        "executable",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "administrativeOperations": {
          "maxItems": 44,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "typing.begin",
              "typing.end",
              "text.send",
              "text.stream",
              "markdown.send",
              "link.send",
              "content.group",
              "content.compose",
              "message.get",
              "message.reply",
              "message.react",
              "reaction.remove",
              "message.edit",
              "message.unsend",
              "message.markRead",
              "attachment.send",
              "attachment.fetch",
              "voice.send",
              "contact.send",
              "poll.create",
              "poll.get",
              "poll.vote",
              "poll.unvote",
              "poll.addOption",
              "app.send",
              "app.sendCustomized",
              "app.update",
              "space.get",
              "space.create",
              "space.getName",
              "space.rename",
              "space.getMembers",
              "space.addMembers",
              "space.removeMembers",
              "space.leave",
              "space.getAvatar",
              "space.setAvatar",
              "space.clearAvatar",
              "space.setBackground",
              "space.clearBackground",
              "account.shareContact",
              "effect.send",
              "metadata.get",
              "custom.send"
            ]
          }
        },
        "allowedRecipients": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          }
        },
        "allowNativeContent": {
          "type": "boolean"
        }
      },
      "required": [
        "administrativeOperations",
        "allowedRecipients",
        "allowNativeContent"
      ],
      "additionalProperties": false
    },
    "cardBackend": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "signed-card-v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "participants": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_:+.@/-]+$"
              },
              "imessageAddress": {
                "type": "string",
                "minLength": 3,
                "maxLength": 254
              },
              "publicKey": {
                "type": "object",
                "properties": {
                  "kty": {
                    "type": "string",
                    "const": "OKP"
                  },
                  "crv": {
                    "type": "string",
                    "const": "Ed25519"
                  },
                  "x": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{43}$"
                  }
                },
                "required": [
                  "kty",
                  "crv",
                  "x"
                ],
                "additionalProperties": false
              },
              "enrollmentEvidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "id",
              "imessageAddress",
              "publicKey",
              "enrollmentEvidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "id",
        "origin",
        "port",
        "participants"
      ],
      "additionalProperties": false
    },
    "cards": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_:+.@/-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "universal",
              "customized"
            ]
          },
          "backendId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_:+.@/-]+$"
          },
          "origins": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "extension": {
            "type": "object",
            "properties": {
              "appName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "teamId": {
                "type": "string",
                "pattern": "^[A-Z0-9]{10}$"
              },
              "extensionBundleId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
              },
              "appStoreId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "appName",
              "teamId",
              "extensionBundleId"
            ],
            "additionalProperties": false
          },
          "live": {
            "type": "object",
            "properties": {
              "installedExtensionVerified": {
                "type": "boolean",
                "const": true
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "installedExtensionVerified",
              "evidence"
            ],
            "additionalProperties": false
          },
          "interactions": {
            "type": "object",
            "properties": {
              "participantIds": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                }
              },
              "actionIds": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_:+.@/-]+$"
                }
              },
              "ttlMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 86400000
              },
              "backendContractId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_:+.@/-]+$"
              }
            },
            "required": [
              "participantIds",
              "actionIds",
              "ttlMs",
              "backendContractId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "origins"
        ],
        "additionalProperties": false
      }
    },
    "ownerAdministration": {
      "type": "object",
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "credentialFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "principalId",
        "credentialFile"
      ],
      "additionalProperties": false
    },
    "textStreaming": {
      "type": "object",
      "properties": {
        "delivery": {
          "type": "string",
          "enum": [
            "progressive",
            "buffered"
          ]
        }
      },
      "required": [
        "delivery"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "captureDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "stagingDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "importDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "statePath",
        "captureDirectory",
        "stagingDirectory"
      ],
      "additionalProperties": false
    },
    "ownerModel": {
      "type": "string",
      "enum": [
        "installation-owner",
        "legacy-task"
      ]
    },
    "activateAfterValidation": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "activation",
    "provider",
    "local",
    "task",
    "grok",
    "authorization",
    "cards",
    "runtime",
    "ownerModel",
    "activateAfterValidation"
  ],
  "additionalProperties": false
}
