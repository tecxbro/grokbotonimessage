{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "stream": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_:+.@/-]+$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_:+.@/-]+$"
            },
            "provider": {
              "type": "string",
              "const": "imessage"
            },
            "accountId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_:+.@/-]+$"
            },
            "lineId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_:+.@/-]+$"
            },
            "spaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_:+.@/-]+$"
            }
          },
          "required": [
            "projectId",
            "provider",
            "accountId",
            "lineId",
            "spaceId"
          ],
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "const": "stream"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "id",
        "scope",
        "kind",
        "generation",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    }
  },
  "required": [
    "version",
    "stream",
    "sequence"
  ],
  "additionalProperties": false
}
